<%- include('header.ejs'); %>

<div class="row">
  <div class="col-12">

    <h1>Welcome Blog Panel</h1>

  </div>

  <div class="col-12" >
       <form action="/admin/blog_save" method="post" enctype="multipart/form-data">
        <label>Blog Image</label>
        <input type="file" name="bimage" class="form-control mb-4" >
        <label>Blog Date</label>
        <input type="date" name="bdate" class="form-control mb-4">
        <label>Title</label>
        <input type="text" name="btitle" class="form-control mb-4">
        <label>Author</label>
        <input type="text" name="bauthor" class="form-control mb-4">
        <label>Decs</label>
        <input type="text" name="bdesc" class="form-control mb-4">
        <button class="btn btn-primary">Save</button>
       </form>
  </div>

  <div class="col-12 table-responsive">
    <table class="table table-primary ">
        <tr>
            <th>Sr. No</th>
            <th>Image</th>
            <th>Date</th>
            <th>Title</th>
            <th>Author</th>
            <th>Desc</th>
            <th>Status</th>
        </tr>
        <% for(var i=0;i<data.length;i++){%>
         <tr>
            <td><%= i+1 %></td>
            <td>
                <img src="/<%= data[i].bimage %>">
            </td>
            <td><%= data[i].bdate%></td>
            <td><%= data[i].btitle%></td>
            <td><%= data[i].bauthor%></td>
            <td><%= data[i].bdesc%></td>
            <td>
                <a><button class="btn btn-danger">Delete</button></a>
                <a><button class="btn btn-warning">Edit</button></a>
            </td>
        </tr>
        <% } %>
    </table>
  </div>
</div>

<%- include('footer.ejs'); %>