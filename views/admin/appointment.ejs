<%- include('header.ejs'); %>


<h1>Welcome User Appointment Data</h1>


<div class="col-12 table-responsive">
<table class="table table-primary">
    <tr>
        <th>Sr. No</th>
        <th>Department</th>
        <th>First Name</th>
        <th>Last Name</th>
        <th>Phone</th>
        <th>Email</th>
        <th>Date</th>
        <th>Status</th>
    </tr>

    <% for(var i=0; i<data.length; i++){ %>
    <tr>
        <td><%= i+1 %></td>
        <td><%= data[i].adepa %></td>
        <td><%= data[i].aname %></td>
        <td><%= data[i].alastname %></td>
        <td><%= data[i].amobile %></td>
        <td><%= data[i].aemail %></td>
        <td><%= data[i].adate %></td>
        <td>
            <a><button class="btn btn-danger">Delete</button></a>
            <a><button class="btn btn-warning">Edit</button></a>
        </td>
    </tr>
    <% } %>
</table>
</div>

<%- include('footer.ejs'); %>