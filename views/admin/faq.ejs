<%- include('header.ejs'); %>

<div class="row">
  <div class="col-12">

    <h1>Welcome FAQ Panel</h1>

  </div>

  <div class="col-12" >
       <form action="/admin/faq_save" method="post">
        <label>F_que</label>
        <input type="text" name="f_que" class="form-control mb-4" >
        <label>F_ans</label>
        <input type="text" name="f_ans" class="form-control mb-4" >
        <button class="btn btn-primary">Save</button>
       </form>
  </div>

  <div class="col-12 table-responsive">
    <table class="table table-primary ">
        <tr>
            <th>Sr. No</th>
            <th>F_que</th>
            <th>F_ans</th>
            <th>Status</th>
        </tr>
        <% for(var i=0;i<data.length;i++){%>
         <tr>
            <td><%= i+1 %></td>
            <td><%= data[i].f_que %></td>
            <td><%= data[i].f_ans%></td>
            
            <td>
                <a><button class="btn btn-danger">Delete</button></a>
                <a><button class="btn btn-warning">Edit</button></a>
            </td>
        </tr>
        <% } %>
    </table>
  </div>
</div>

<%- include('footer.ejs'); %>